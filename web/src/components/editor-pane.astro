---
import { getLanguageConfig } from "../lib/compiler";

interface Props {
  initialCode?: string;
  initialLanguage?: string;
  initialFilename?: string;
}

const { initialCode, initialLanguage = "python", initialFilename } = Astro.props;
const language = getLanguageConfig(initialLanguage);
const filename = initialFilename ?? language.filename;
---

<section class="pane-body" data-pane="editor">
  <div class="pane-header">
    <div class="tabs" role="tablist" aria-label="Editor panels">
      <button
        id="tab-code"
        class="tab"
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="code-editor-panel"
        data-target="code-editor-panel"
      >
        Code
      </button>
      <button
        id="tab-stdin"
        class="tab"
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="stdin-panel"
        tabindex="-1"
        data-target="stdin-panel"
      >
        Input (stdin)
        <span class="tab-count" id="stdin-count" hidden>0</span>
      </button>
    </div>
    <span class="filename" id="editor-filename">{filename}</span>
  </div>

  <div id="code-editor-panel" class="pane-body" role="tabpanel" aria-labelledby="tab-code">
    <div id="editor-status" class="editor-status">Loading editor…</div>
    <div
      id="monaco-editor"
      class="editor-host"
      data-initial-code={initialCode}
      data-initial-language={language.key}
      hidden
    ></div>
  </div>

  <div id="stdin-panel" class="stdin-panel" role="tabpanel" aria-labelledby="tab-stdin" hidden>
    <label class="field-label" for="stdin-input">
      <span>Standard input</span>
      <span class="field-hint">One line per input</span>
    </label>
    <textarea
      id="stdin-input"
      class="stdin-input"
      spellcheck="false"
      autocomplete="off"
      placeholder="Leave empty if your program does not read input."
      aria-describedby="stdin-hint"
    ></textarea>
    <p class="field-hint" id="stdin-hint">
      Each line is passed to your program in order, as if typed at the terminal.
    </p>
  </div>
</section>

<script>
  import loader from "@monaco-editor/loader";
  import { getLanguageConfig } from "../lib/compiler";

  type MonacoModel = unknown;

  type MonacoEditorInstance = {
    getModel: () => MonacoModel;
    getValue: () => string;
    setValue: (value: string) => void;
    layout: () => void;
    focus: () => void;
  };

  type MonacoEditorApi = {
    setModelLanguage: (model: MonacoModel, language: string) => void;
    setTheme: (theme: string) => void;
    create: (container: HTMLElement, options: Record<string, unknown>) => MonacoEditorInstance;
  };

  type MonacoModule = {
    editor: MonacoEditorApi;
  };

  const container = document.getElementById("monaco-editor");
  const status = document.getElementById("editor-status");
  const filenameLabel = document.getElementById("editor-filename");
  const stdinInput = document.getElementById("stdin-input") as HTMLTextAreaElement | null;
  const stdinCount = document.getElementById("stdin-count");

  const initialCode = container?.dataset.initialCode;
  const hasInitialCode = initialCode !== undefined;
  const requestedLanguage = container?.dataset.initialLanguage ?? "python";
  const initialConfig = getLanguageConfig(requestedLanguage);

  let monacoRef: MonacoModule | null = null;
  let editorRef: MonacoEditorInstance | null = null;
  let activeLanguage = initialConfig.key;
  let activeStarterCode = initialCode ?? initialConfig.starterCode;
  let isStarterCode = !hasInitialCode;
  let pendingCode: string | null = null;

  const getCode = () => {
    if (editorRef) return editorRef.getValue();
    return pendingCode ?? activeStarterCode;
  };

  window.__compilerEditorApi = {
    getCode,
    getStdin: () => stdinInput?.value ?? "",
    focus: () => {
      if (editorRef) {
        editorRef.focus();
        return;
      }
      document.getElementById("tab-code")?.focus();
    }
  };

  /* Tabs ---------------------------------------------------------------- */

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

  const activateTab = (tab: HTMLButtonElement, moveFocus = false) => {
    tabs.forEach((item) => {
      const selected = item === tab;
      item.setAttribute("aria-selected", String(selected));
      item.tabIndex = selected ? 0 : -1;
    });

    panels.forEach((panel) => {
      panel.hidden = panel.id !== tab.dataset.target;
    });

    if (moveFocus) tab.focus();
    if (tab.dataset.target === "code-editor-panel") editorRef?.layout();
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => activateTab(tab));

    tab.addEventListener("keydown", (event) => {
      let nextIndex: number | null = null;

      if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
      if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
      if (event.key === "Home") nextIndex = 0;
      if (event.key === "End") nextIndex = tabs.length - 1;

      if (nextIndex === null) return;
      event.preventDefault();
      activateTab(tabs[nextIndex], true);
    });
  });

  /* Stdin --------------------------------------------------------------- */

  const updateStdinCount = () => {
    if (!stdinCount || !stdinInput) return;

    const lines = stdinInput.value === "" ? 0 : stdinInput.value.split("\n").length;
    stdinCount.textContent = String(lines);
    stdinCount.hidden = lines === 0;
  };

  stdinInput?.addEventListener("input", updateStdinCount);
  updateStdinCount();

  /* Language and theme -------------------------------------------------- */

  const setEditorLanguage = (selectedLanguage: string) => {
    const config = getLanguageConfig(selectedLanguage);

    if (filenameLabel) filenameLabel.textContent = config.filename;

    if (!monacoRef || !editorRef) {
      activeLanguage = config.key;
      return;
    }

    const model = editorRef.getModel();
    if (!model) return;

    if (isStarterCode && editorRef.getValue() === activeStarterCode) {
      editorRef.setValue(config.starterCode);
      activeStarterCode = config.starterCode;
    } else {
      isStarterCode = false;
    }

    monacoRef.editor.setModelLanguage(model, config.monacoLanguage);
    activeLanguage = config.key;
  };

  window.addEventListener("compiler-language-change", (event) => {
    if (!(event instanceof CustomEvent)) return;

    const selectedLanguage = event.detail?.language;
    if (typeof selectedLanguage !== "string") return;

    setEditorLanguage(selectedLanguage);
  });

  window.addEventListener("compiler-theme-change", (event) => {
    if (!(event instanceof CustomEvent)) return;

    const selectedTheme = event.detail?.theme;
    if (selectedTheme !== "dark" && selectedTheme !== "light") return;

    monacoRef?.editor.setTheme(selectedTheme === "light" ? "vs" : "vs-dark");
  });

  /* Monaco bootstrap ---------------------------------------------------- */

  const showEditorError = () => {
    if (!status) return;

    status.classList.add("editor-status-error");
    status.textContent = "The code editor could not load. Check your connection, then reload the page.";
  };

  if (container) {
    loader
      .init()
      .then((monaco) => {
        monacoRef = monaco as MonacoModule;
        editorRef = monaco.editor.create(container, {
          value: activeStarterCode,
          language: getLanguageConfig(activeLanguage).monacoLanguage,
          theme: document.documentElement.dataset.theme === "light" ? "vs" : "vs-dark",
          ariaLabel: "Code editor",
          minimap: { enabled: false },
          fontSize: 14,
          fontFamily:
            'ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace',
          automaticLayout: true,
          scrollBeyondLastLine: false,
          tabSize: 4,
          padding: { top: 12, bottom: 12 }
        });

        container.hidden = false;
        if (status) status.hidden = true;

        if (pendingCode !== null) {
          editorRef.setValue(pendingCode);
          pendingCode = null;
        }

        editorRef.layout();
      })
      .catch((error) => {
        console.error("Failed to load Monaco editor.", error);
        showEditorError();
      });
  }

  // Keep the fallback code in sync if the editor never loads.
  window.addEventListener("compiler-language-change", (event) => {
    if (!(event instanceof CustomEvent)) return;
    if (editorRef) return;

    const selectedLanguage = event.detail?.language;
    if (typeof selectedLanguage !== "string") return;

    const config = getLanguageConfig(selectedLanguage);
    if (isStarterCode) {
      pendingCode = config.starterCode;
      activeStarterCode = config.starterCode;
    }
  });
</script>
