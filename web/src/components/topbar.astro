---
import { Moon, Sun } from "@lucide/astro";
import { REPOSITORY_URL } from "../lib/compiler";
---

<header class="app-header">
  <a class="brand" href="/" aria-label="Online Compiler home">
    <img class="brand-mark" src="/anga.svg" alt="" width="28" height="28" />
    <span class="brand-text">
      <span class="brand-title">Online Compiler</span>
      <span class="brand-subtitle">C · C++ · Python · Java</span>
    </span>
  </a>

  <div class="header-actions">
    <a
      class="btn btn-github"
      href={REPOSITORY_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="View source code on GitHub (opens in a new tab)"
    >
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
      <span class="btn-github-label">GitHub</span>
    </a>

    <button
      id="theme-toggle"
      class="btn btn-icon"
      type="button"
      aria-label="Switch to light theme"
      title="Switch theme"
    >
      <Sun id="theme-icon-sun" aria-hidden="true" />
      <Moon id="theme-icon-moon" aria-hidden="true" hidden />
    </button>
  </div>
</header>

<script>
  type Theme = "light" | "dark";

  const root = document.documentElement;
  const themeToggle = document.getElementById("theme-toggle");
  const sunIcon = document.getElementById("theme-icon-sun");
  const moonIcon = document.getElementById("theme-icon-moon");
  const themeColorMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const applyTheme = (theme: Theme) => {
    root.dataset.theme = theme;
    localStorage.setItem("compiler-theme", theme);

    sunIcon?.toggleAttribute("hidden", theme === "light");
    moonIcon?.toggleAttribute("hidden", theme === "dark");

    themeToggle?.setAttribute(
      "aria-label",
      theme === "light" ? "Switch to dark theme" : "Switch to light theme"
    );

    themeColorMeta?.setAttribute("content", theme === "light" ? "#ffffff" : "#1e1e1e");

    window.dispatchEvent(
      new CustomEvent("compiler-theme-change", { detail: { theme } })
    );
  };

  const savedTheme = localStorage.getItem("compiler-theme");
  const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
  applyTheme(savedTheme === "light" || savedTheme === "dark" ? savedTheme : prefersLight ? "light" : "dark");

  themeToggle?.addEventListener("click", () => {
    applyTheme(root.dataset.theme === "light" ? "dark" : "light");
  });
</script>
