<section class="pane-body" data-pane="output">
  <div class="pane-header">
    <h2 class="pane-title">Output</h2>
    <p class="output-status" id="output-status" data-state="idle" role="status" aria-live="polite">
      <span class="status-dot" aria-hidden="true"></span>
      <span id="output-status-text">Ready</span>
    </p>
  </div>

  <dl class="metrics">
    <div class="metric">
      <dt>Time</dt>
      <dd id="output-time">—</dd>
    </div>
    <div class="metric">
      <dt>Memory</dt>
      <dd id="output-memory">—</dd>
    </div>
  </dl>

  <div class="output-scroll">
    <p class="output-empty" id="output-empty">
      Run your code to see its output here.
    </p>
    <pre id="output-text" class="output-pre" hidden></pre>

    <div id="output-notice" class="notice" role="alert" hidden>
      <p class="notice-title" id="output-notice-title"></p>
      <p class="notice-message" id="output-notice-message"></p>
      <p class="notice-hint" id="output-notice-hint"></p>
    </div>
  </div>
</section>

<script>
  import {
    EXECUTE_ENDPOINT,
    LIMITS,
    NANOSECONDS_PER_SECOND,
    clampMemory,
    clampTimeout,
    formatCpuTime,
    formatMemory
  } from "../lib/compiler";

  const REQUEST_TIMEOUT_MS = 30_000;

  const runButton = document.getElementById("run-code-button") as HTMLButtonElement | null;
  const runButtonLabel = document.getElementById("run-button-label");
  const statusElement = document.getElementById("output-status");
  const statusText = document.getElementById("output-status-text");
  const timeElement = document.getElementById("output-time");
  const memoryElement = document.getElementById("output-memory");
  const emptyElement = document.getElementById("output-empty");
  const outputElement = document.getElementById("output-text");
  const noticeElement = document.getElementById("output-notice");
  const noticeTitle = document.getElementById("output-notice-title");
  const noticeMessage = document.getElementById("output-notice-message");
  const noticeHint = document.getElementById("output-notice-hint");

  let isRequestInFlight = false;
  let selectedLanguage = "python";

  const setStatus = (state: "idle" | "running" | "success" | "error", text: string) => {
    if (statusElement) statusElement.dataset.state = state;
    if (statusText) statusText.textContent = text;
  };

  const setRunButtonState = (isRunning: boolean) => {
    if (!runButton) return;

    runButton.disabled = isRunning;
    runButton.setAttribute("aria-busy", String(isRunning));
    if (runButtonLabel) runButtonLabel.textContent = isRunning ? "Running…" : "Run code";
  };

  const setMetrics = (cpuTime: unknown, memoryUsed: unknown) => {
    if (timeElement) timeElement.textContent = formatCpuTime(cpuTime);
    if (memoryElement) memoryElement.textContent = formatMemory(memoryUsed);
  };

  const resetMetrics = () => {
    if (timeElement) timeElement.textContent = "—";
    if (memoryElement) memoryElement.textContent = "—";
  };

  const showOutput = (text: string) => {
    if (!outputElement || !emptyElement) return;

    outputElement.textContent = text;
    outputElement.hidden = false;
    emptyElement.hidden = true;
  };

  const showEmpty = (text: string) => {
    if (!outputElement || !emptyElement) return;

    outputElement.textContent = "";
    outputElement.hidden = true;
    emptyElement.textContent = text;
    emptyElement.hidden = false;
  };

  type NoticeKind = "warning" | "error";

  const showNotice = (kind: NoticeKind, title: string, message: string, hint: string) => {
    if (!noticeElement || !noticeTitle || !noticeMessage || !noticeHint) return;

    noticeElement.classList.toggle("notice-warning", kind === "warning");
    noticeElement.classList.toggle("notice-error", kind === "error");
    noticeTitle.textContent = title;
    noticeMessage.textContent = message;
    noticeHint.textContent = hint;
    noticeElement.hidden = false;
  };

  const clearNotice = () => {
    if (!noticeElement) return;

    noticeElement.hidden = true;
    if (noticeTitle) noticeTitle.textContent = "";
    if (noticeMessage) noticeMessage.textContent = "";
    if (noticeHint) noticeHint.textContent = "";
  };

  const getLimits = () => {
    const timeoutInput = document.getElementById("time-limit") as HTMLInputElement | null;
    const memoryInput = document.getElementById("memory-limit") as HTMLInputElement | null;

    return {
      timeout: clampTimeout(Number(timeoutInput?.value ?? LIMITS.defaultTimeoutSeconds)),
      memoryMb: clampMemory(Number(memoryInput?.value ?? LIMITS.defaultMemoryMb))
    };
  };

  const getLanguage = () => {
    const selectedButton = document.querySelector<HTMLButtonElement>(
      '.language-button[aria-pressed="true"]'
    );
    return selectedButton?.dataset.language ?? selectedLanguage;
  };

  window.addEventListener("compiler-language-change", (event) => {
    if (!(event instanceof CustomEvent)) return;

    const changedLanguage = event.detail?.language;
    if (typeof changedLanguage !== "string") return;

    selectedLanguage = changedLanguage;
  });

  const runCode = async () => {
    if (isRequestInFlight) return;

    const editorApi = window.__compilerEditorApi;
    const code = editorApi?.getCode() ?? "";

    if (!code.trim()) {
      clearNotice();
      showEmpty("Nothing to run. Write some code in the editor first.");
      setStatus("error", "Nothing to run");
      resetMetrics();
      editorApi?.focus();
      return;
    }

    const stdin = editorApi?.getStdin() ?? "";
    const language = getLanguage();
    const { timeout, memoryMb } = getLimits();

    isRequestInFlight = true;
    setRunButtonState(true);
    setStatus("running", "Running…");
    clearNotice();
    resetMetrics();
    showEmpty("Running your code…");

    const controller = new AbortController();
    const abortTimer = window.setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);

    try {
      const response = await fetch(EXECUTE_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        signal: controller.signal,
        body: JSON.stringify({
          language,
          code,
          timeout: Math.round(timeout * NANOSECONDS_PER_SECOND),
          max_memory: memoryMb * 1024,
          inputs: stdin
        })
      });

      let payload: Record<string, unknown> | null = null;
      try {
        payload = (await response.json()) as Record<string, unknown>;
      } catch {
        payload = null;
      }

      if (!response.ok) {
        const message =
          typeof payload?.error === "string"
            ? payload.error
            : `The execution service returned status ${response.status}.`;

        showEmpty("The code did not run.");
        showNotice(
          "error",
          "Execution service error",
          message,
          "This is a problem with the service, not your code. Try again in a moment."
        );
        setStatus("error", "Failed");
        return;
      }

      const output = typeof payload?.output === "string" ? payload.output : "";
      const error = typeof payload?.error === "string" ? payload.error : "";

      setMetrics(payload?.cpu_time, payload?.memory_used);

      if (output) {
        showOutput(output);
      } else {
        showEmpty(error ? "No standard output." : "Program produced no output.");
      }

      if (error) {
        const normalized = error.trim().toLowerCase();

        if (normalized === "execution timed out") {
          showNotice(
            "warning",
            "Time limit reached",
            error,
            `Your program ran longer than ${timeout} s. Increase the time limit or check for infinite loops.`
          );
        } else if (normalized === "memory limit exceeded") {
          showNotice(
            "warning",
            "Memory limit reached",
            error,
            `Your program used more than ${memoryMb} MB. Increase the memory limit or reduce memory usage.`
          );
        } else {
          showNotice(
            "error",
            "Program error",
            error,
            "Read the message above, fix your code, then run again."
          );
        }

        setStatus("error", "Finished with errors");
      } else {
        setStatus("success", "Finished");
      }
    } catch (error) {
      const isAbort = error instanceof DOMException && error.name === "AbortError";

      showEmpty("The code did not run.");
      showNotice(
        "error",
        isAbort ? "Request timed out" : "Could not reach the execution service",
        isAbort
          ? "The execution service did not respond in time."
          : error instanceof Error
            ? error.message
            : "The request failed.",
        "Check your connection and try again."
      );
      setStatus("error", "Failed");
      resetMetrics();
    } finally {
      window.clearTimeout(abortTimer);
      isRequestInFlight = false;
      setRunButtonState(false);
    }
  };

  runButton?.addEventListener("click", runCode);

  document.addEventListener(
    "keydown",
    (event) => {
      if (event.key !== "Enter" || !(event.ctrlKey || event.metaKey)) return;

      event.preventDefault();
      runCode();
    },
    { capture: true }
  );
</script>

