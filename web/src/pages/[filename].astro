---
import "../styles/global.css";
import CompilerBody from "../components/compiler-body.astro";
import Topbar from "../components/topbar.astro";
import { REPOSITORY_URL, getAngaDriveFileUrl, inferCompilerLanguage } from "../lib/compiler";

const filename = Astro.params.filename;
let source: string | null = null;
let errorMessage = "The requested source file could not be found.";

if (filename) {
  try {
    const response = await fetch(getAngaDriveFileUrl(filename));

    if (response.ok) {
      source = await response.text();
    } else {
      Astro.response.status = response.status === 404 ? 404 : 502;
      errorMessage =
        response.status === 404
          ? `The source file "${filename}" could not be found.`
          : "AngaDrive could not provide the requested source file.";
    }
  } catch (error) {
    console.error("Failed to load source from AngaDrive.", error);
    Astro.response.status = 502;
    errorMessage = "The source file could not be loaded right now.";
  }
} else {
  Astro.response.status = 404;
}

const language = inferCompilerLanguage(filename ?? "");
const pageTitle = source === null ? "File not found | Anga's Online Compiler" : `${filename} | Anga's Online Compiler`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/anga.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#1e1e1e" />
    <meta name="robots" content={source === null ? "noindex, nofollow" : "index, follow"} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("compiler-theme");
          const theme =
            saved === "light" || saved === "dark"
              ? saved
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body>
    <div class="app">
      <Topbar />
      {
        source === null ? (
          <main class="page-message">
            <h1>Couldn't open this file</h1>
            <p>{errorMessage}</p>
            <div class="page-message-actions">
              <a class="btn btn-primary" href="/">Open the compiler</a>
              <a
                class="btn"
                href={REPOSITORY_URL}
                target="_blank"
                rel="noopener noreferrer"
              >
                View source on GitHub
              </a>
            </div>
          </main>
        ) : (
          <CompilerBody
            initialCode={source}
            initialLanguage={language}
            initialFilename={filename}
          />
        )
      }
    </div>
  </body>
</html>

